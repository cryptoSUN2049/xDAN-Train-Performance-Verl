# Fusion overlay: source after scripts/runtime.env, before `ray start`.
# Points every process (driver, Ray head, workers) at the fusion source instead of source-a2ad9f61.
export SOURCE=/workspace/xdan-verl-fusion/source-1d215820
export PYTHONPATH="$SOURCE:$SOURCE/third_party/mimoagent-osr/src:$SOURCE/third_party/uni_agent"
export XDAN_FUSION_ROOT=/workspace/xdan-verl-fusion
# No RL-Insight server on this pod.
export VERL_RL_INSIGHT_ENABLE=0
